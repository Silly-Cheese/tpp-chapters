rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdministrativeReviewer() {
      let user = firestore.get(/databases/(default)/documents/systemUsers/$(request.auth.uid)).data;
      return signedIn()
        && user.accountStatus == 'active'
        && user.systemRole in ['owner', 'chapterAdmin', 'complianceAdmin'];
    }

    function isSupportStaff() {
      let user = firestore.get(/databases/(default)/documents/systemUsers/$(request.auth.uid)).data;
      return signedIn()
        && user.accountStatus == 'active'
        && user.systemRole in ['owner', 'chapterAdmin', 'complianceAdmin', 'supportAgent'];
    }

    function membershipKey(chapterId) {
      return chapterId + '__' + request.auth.uid;
    }

    function hasChapterMembership(chapterId) {
      let membership = firestore.get(/databases/(default)/documents/chapterMemberships/$(membershipKey(chapterId))).data;
      return signedIn()
        && request.auth.token.email_verified == true
        && membership.status == 'active';
    }

    function chapterCanAccessSupportTicket(chapterId, ticketId) {
      let membership = firestore.get(/databases/(default)/documents/chapterMemberships/$(membershipKey(chapterId))).data;
      let ticket = firestore.get(/databases/(default)/documents/supportTickets/$(ticketId)).data;
      return signedIn()
        && request.auth.token.email_verified == true
        && membership.status == 'active'
        && ticket.chapterId == chapterId
        && ((ticket.visibility == 'chapter')
          || (ticket.visibility == 'adviser_private'
            && ticket.createdByUid == request.auth.uid
            && membership.role == 'adviser'));
    }

    function staffCanAccessSupportTicket(chapterId, ticketId) {
      let user = firestore.get(/databases/(default)/documents/systemUsers/$(request.auth.uid)).data;
      let ticket = firestore.get(/databases/(default)/documents/supportTickets/$(ticketId)).data;
      return signedIn()
        && user.accountStatus == 'active'
        && user.systemRole in ['owner', 'chapterAdmin', 'complianceAdmin', 'supportAgent']
        && ticket.chapterId == chapterId;
    }

    function ownsEditableSubmission(chapterId, submissionId) {
      let item = firestore.get(/databases/(default)/documents/chapterSubmissions/$(submissionId)).data;
      return item.chapterId == chapterId
        && item.submittedByUid == request.auth.uid
        && item.status in ['draft', 'changes_requested'];
    }

    function allowedContentType() {
      return request.resource.contentType in [
        'application/pdf',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'image/png',
        'image/jpeg'
      ];
    }

    function validUpload() {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && allowedContentType();
    }

    match /chapter-submissions/{chapterId}/{submissionId}/{uid}/{fileName} {
      allow read: if isAdministrativeReviewer() || hasChapterMembership(chapterId);

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && hasChapterMembership(chapterId)
        && ownsEditableSubmission(chapterId, submissionId)
        && validUpload();

      allow delete: if isAdministrativeReviewer()
        || (signedIn()
          && request.auth.uid == uid
          && hasChapterMembership(chapterId)
          && ownsEditableSubmission(chapterId, submissionId));
    }

    // Chapter-authored support files use exactly two Firestore lookups:
    // the chapter membership and the parent support ticket.
    match /support-attachments/chapter/{chapterId}/{ticketId}/{messageId}/{uid}/{fileName} {
      allow read: if signedIn()
        && request.auth.uid == uid
        && chapterCanAccessSupportTicket(chapterId, ticketId);

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && chapterCanAccessSupportTicket(chapterId, ticketId)
        && validUpload();

      allow delete: if signedIn()
        && request.auth.uid == uid
        && chapterCanAccessSupportTicket(chapterId, ticketId);
    }

    // Staff-authored support files use exactly two Firestore lookups:
    // the active staff profile and the parent support ticket.
    match /support-attachments/staff/{chapterId}/{ticketId}/{messageId}/{uid}/{fileName} {
      allow read: if signedIn()
        && request.auth.uid == uid
        && staffCanAccessSupportTicket(chapterId, ticketId);

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && staffCanAccessSupportTicket(chapterId, ticketId)
        && validUpload();

      allow delete: if signedIn()
        && request.auth.uid == uid
        && staffCanAccessSupportTicket(chapterId, ticketId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
