rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasUserRecord() {
      return signedIn()
        && exists(/databases/$(database)/documents/systemUsers/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/systemUsers/$(request.auth.uid)).data;
    }


    function isActive() {
      return hasUserRecord()
        && currentUser().accountStatus == 'active';
    }

    function hasRole(allowedRoles) {
      return isActive() && currentUser().systemRole in allowedRoles;
    }

    function isOwner() {
      return hasRole(['owner']);
    }

    function canManageRegistry() {
      return hasRole(['owner', 'chapterAdmin']);
    }

    function canManageInvitations() {
      return hasRole(['owner', 'chapterAdmin']);
    }

    function canManageChapterWorkspaces() {
      return hasRole(['owner', 'chapterAdmin', 'complianceAdmin']);
    }

    function canReviewSubmissions() {
      return hasRole(['owner', 'chapterAdmin', 'complianceAdmin']);
    }

    function canManageSupport() {
      return hasRole(['owner', 'chapterAdmin', 'complianceAdmin', 'supportAgent']);
    }

    function canReadChapterOperations() {
      return hasRole(['owner', 'chapterAdmin', 'complianceAdmin', 'supportAgent']);
    }

    function isAdministrativeStaff() {
      return hasRole(['owner', 'chapterAdmin', 'complianceAdmin', 'supportAgent']);
    }

    function membershipId(chapterId, uid) {
      return chapterId + '__' + uid;
    }

    function validChapterId(chapterId) {
      return chapterId is string
        && chapterId.size() >= 8
        && chapterId.size() <= 39
        && chapterId.matches('^TPP-CH-[A-Z0-9]{1,32}$');
    }

    function invitationChapterIsReady(chapterId, chapterName) {
      return exists(/databases/$(database)/documents/chapters/$(chapterId))
        && get(/databases/$(database)/documents/chapters/$(chapterId)).data.officialName == chapterName;
    }

    function hasChapterMembership(chapterId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chapterMemberships/$(membershipId(chapterId, request.auth.uid)))
        && get(/databases/$(database)/documents/chapterMemberships/$(membershipId(chapterId, request.auth.uid))).data.status == 'active';
    }

    function chapterMembership(chapterId) {
      return get(/databases/$(database)/documents/chapterMemberships/$(membershipId(chapterId, request.auth.uid))).data;
    }

    function hasChapterMembershipRole(chapterId, allowedRoles) {
      return hasChapterMembership(chapterId)
        && chapterMembership(chapterId).role in allowedRoles;
    }

    function inviteAfter(inviteId) {
      return getAfter(/databases/$(database)/documents/chapterInvitations/$(inviteId)).data;
    }

    function validSelfActivatedProfile(uid) {
      let invite = inviteAfter(request.resource.data.activationInvitationId);
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'displayName', 'email', 'systemRole', 'accountStatus',
          'primaryChapterId', 'primaryChapterRole', 'activationInvitationId',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'systemRole', 'accountStatus',
          'primaryChapterId', 'primaryChapterRole', 'activationInvitationId',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.systemRole in ['director', 'adviser']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && invite.status == 'claimed'
        && invite.claimedByUid == uid
        && invite.email == request.auth.token.email
        && invite.role == request.resource.data.systemRole
        && invite.chapterId == request.resource.data.primaryChapterId
        && invite.role == request.resource.data.primaryChapterRole
        && invite.expiresAt > request.time;
    }

    function validInvitationClaim(inviteId) {
      let memberId = resource.data.chapterId + '__' + request.auth.uid;
      let member = getAfter(/databases/$(database)/documents/chapterMemberships/$(memberId)).data;
      return signedIn()
        && resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'claimedByUid', 'claimedAt', 'updatedAt'
        ])
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedByUid == request.auth.uid
        && request.resource.data.claimedAt == request.time
        && request.resource.data.updatedAt == request.time
        && member.uid == request.auth.uid
        && member.chapterId == resource.data.chapterId
        && member.role == resource.data.role
        && member.invitationId == inviteId
        && member.status == 'active';
    }

    function validSelfMembership(memberId) {
      let invite = inviteAfter(request.resource.data.invitationId);
      let user = getAfter(/databases/$(database)/documents/systemUsers/$(request.auth.uid)).data;
      return signedIn()
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'chapterId', 'chapterName', 'role',
          'status', 'invitationId', 'grantedBy', 'grantedAt',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'chapterId', 'chapterName', 'role',
          'status', 'invitationId', 'grantedBy', 'grantedAt',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && memberId == request.resource.data.chapterId + '__' + request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.role in ['director', 'adviser']
        && request.resource.data.status == 'active'
        && request.resource.data.grantedBy == 'invitation'
        && request.resource.data.grantedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && invite.status == 'claimed'
        && invite.claimedByUid == request.auth.uid
        && invite.email == request.auth.token.email
        && invite.chapterId == request.resource.data.chapterId
        && invite.chapterName == request.resource.data.chapterName
        && invite.role == request.resource.data.role
        && invite.expiresAt > request.time
        && user.email == request.auth.token.email
        && user.accountStatus == 'active';
    }

    function validSelfLeader(chapterId, leaderId) {
      let member = chapterMembership(chapterId);
      return hasChapterMembership(chapterId)
        && leaderId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'uid', 'chapterId', 'displayName', 'email', 'role', 'status',
          'agreementStatus', 'trainingStatus', 'startDate',
          'visibleToChapter', 'source', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'chapterId', 'displayName', 'email', 'role', 'status',
          'agreementStatus', 'trainingStatus', 'startDate',
          'visibleToChapter', 'source', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.chapterId == chapterId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.role == member.role
        && request.resource.data.status == 'active'
        && request.resource.data.agreementStatus == 'pending'
        && request.resource.data.trainingStatus == 'pending'
        && request.resource.data.startDate is timestamp
        && request.resource.data.visibleToChapter == true
        && request.resource.data.source == 'self_activation'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validNoticeReceipt(chapterId, receiptId) {
      let noticeId = request.resource.data.noticeId;
      return hasChapterMembership(chapterId)
        && receiptId == noticeId + '__' + request.auth.uid
        && exists(/databases/$(database)/documents/chapters/$(chapterId)/notices/$(noticeId))
        && get(/databases/$(database)/documents/chapters/$(chapterId)/notices/$(noticeId)).data.requireAcknowledgment == true
        && request.resource.data.keys().hasAll([
          'noticeId', 'chapterId', 'uid', 'acknowledgedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'noticeId', 'chapterId', 'uid', 'acknowledgedAt', 'updatedAt'
        ])
        && request.resource.data.chapterId == chapterId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.acknowledgedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validAdviserCheckin(chapterId) {
      return hasChapterMembershipRole(chapterId, ['adviser'])
        && request.resource.data.keys().hasAll([
          'chapterId', 'createdByUid', 'adviserName', 'category', 'subject',
          'details', 'status', 'confidential', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'chapterId', 'createdByUid', 'adviserName', 'category', 'subject',
          'details', 'status', 'confidential', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.chapterId == chapterId
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.adviserName is string
        && request.resource.data.adviserName.size() >= 2
        && request.resource.data.adviserName.size() <= 100
        && request.resource.data.category in [
          'routine_checkin', 'institutional_change', 'leadership_concern',
          'privacy_concern', 'safety_concern'
        ]
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 4
        && request.resource.data.subject.size() <= 140
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 20
        && request.resource.data.details.size() <= 3000
        && request.resource.data.status == 'submitted'
        && request.resource.data.confidential == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validChapterRosterMemberData(chapterId, data) {
      return data.chapterId == chapterId
        && validChapterId(data.chapterId)
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 100
        && data.preferredName is string
        && data.preferredName.size() <= 60
        && data.email is string
        && data.email.size() <= 160
        && data.memberRole in [
          'member', 'volunteer', 'prayer_leader', 'secretary',
          'treasurer', 'outreach_coordinator'
        ]
        && data.status in ['active', 'inactive', 'removed']
        && data.joinedDate is string
        && data.joinedDate.size() <= 20
        && data.notes is string
        && data.notes.size() <= 1000
        && data.createdByUid is string
        && data.createdByUid.size() > 0
        && data.lastModifiedByUid is string
        && data.lastModifiedByUid.size() > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.removedAt == null || data.removedAt is timestamp);
    }

    function validNewChapterRosterMember(chapterId) {
      return (canManageChapterWorkspaces()
          || hasChapterMembershipRole(chapterId, ['director', 'adviser']))
        && request.resource.data.keys().hasAll([
          'chapterId', 'fullName', 'preferredName', 'email', 'memberRole',
          'status', 'joinedDate', 'notes', 'createdByUid',
          'lastModifiedByUid', 'createdAt', 'updatedAt', 'removedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'chapterId', 'fullName', 'preferredName', 'email', 'memberRole',
          'status', 'joinedDate', 'notes', 'createdByUid',
          'lastModifiedByUid', 'createdAt', 'updatedAt', 'removedAt'
        ])
        && validChapterRosterMemberData(chapterId, request.resource.data)
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.lastModifiedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.removedAt == null;
    }

    function validChapterRosterMemberUpdate(chapterId) {
      return (canManageChapterWorkspaces()
          || hasChapterMembershipRole(chapterId, ['director', 'adviser']))
        && request.resource.data.keys().hasAll([
          'chapterId', 'fullName', 'preferredName', 'email', 'memberRole',
          'status', 'joinedDate', 'notes', 'createdByUid',
          'lastModifiedByUid', 'createdAt', 'updatedAt', 'removedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'chapterId', 'fullName', 'preferredName', 'email', 'memberRole',
          'status', 'joinedDate', 'notes', 'createdByUid',
          'lastModifiedByUid', 'createdAt', 'updatedAt', 'removedAt'
        ])
        && validChapterRosterMemberData(chapterId, request.resource.data)
        && request.resource.data.chapterId == resource.data.chapterId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastModifiedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'preferredName', 'email', 'memberRole', 'status',
          'joinedDate', 'notes', 'lastModifiedByUid', 'updatedAt', 'removedAt'
        ])
        && ((request.resource.data.status == 'removed'
              && request.resource.data.removedAt == request.time)
            || (request.resource.data.status in ['active', 'inactive']
              && request.resource.data.removedAt == null));
    }

    function submissionTypeAllowed(chapterId, type) {
      return (type == 'annual_renewal' && hasChapterMembershipRole(chapterId, ['director']))
        || (type == 'adviser_confirmation' && hasChapterMembershipRole(chapterId, ['adviser']))
        || (type in [
          'meeting_report', 'periodic_report', 'event_proposal',
          'leadership_change', 'institution_change', 'inactivity_request',
          'document_submission'
        ] && hasChapterMembershipRole(chapterId, ['director', 'adviser']));
    }

    function validSubmissionContent(data) {
      return data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 180
        && data.reportingPeriod is string
        && data.reportingPeriod.size() <= 120
        && data.meetingDate is string
        && data.meetingDate.size() <= 40
        && data.eventDate is string
        && data.eventDate.size() <= 40
        && data.eventLocation is string
        && data.eventLocation.size() <= 180
        && data.requestedStartDate is string
        && data.requestedStartDate.size() <= 40
        && data.requestedEndDate is string
        && data.requestedEndDate.size() <= 40
        && data.currentValue is string
        && data.currentValue.size() <= 1000
        && data.proposedValue is string
        && data.proposedValue.size() <= 1000
        && data.requestedChange is string
        && data.requestedChange.size() <= 160
        && data.summary is string
        && data.summary.size() >= 2
        && data.summary.size() <= 1500
        && data.details is string
        && data.details.size() >= 2
        && data.details.size() <= 5000
        && data.nextSteps is string
        && data.nextSteps.size() <= 2500
        && data.supervisionPlan is string
        && data.supervisionPlan.size() <= 2500
        && data.transportationPlan is string
        && data.transportationPlan.size() <= 1800
        && data.budgetNotes is string
        && data.budgetNotes.size() <= 1800
        && data.attendance is number
        && data.attendance >= 0
        && data.attendance <= 100000
        && data.volunteerCount is number
        && data.volunteerCount >= 0
        && data.volunteerCount <= 100000
        && data.volunteerHours is number
        && data.volunteerHours >= 0
        && data.volunteerHours <= 100000
        && data.institutionalApprovalConfirmed is bool
        && data.leadershipRosterConfirmed is bool
        && data.supervisionConfirmed is bool
        && data.attachmentCount is int
        && data.attachmentCount >= 0
        && data.attachmentCount <= 5;
    }

    function validNewSubmission() {
      let chapterId = request.resource.data.chapterId;
      return hasChapterMembership(chapterId)
        && submissionTypeAllowed(chapterId, request.resource.data.type)
        && request.resource.data.keys().hasAll([
          'chapterId', 'chapterName', 'type', 'title', 'status',
          'submittedByUid', 'submittedByName', 'submittedByRole',
          'reportingPeriod', 'meetingDate', 'eventDate', 'eventLocation',
          'requestedStartDate', 'requestedEndDate', 'currentValue',
          'proposedValue', 'requestedChange', 'summary', 'details',
          'nextSteps', 'supervisionPlan', 'transportationPlan', 'budgetNotes',
          'attendance', 'volunteerCount', 'volunteerHours',
          'institutionalApprovalConfirmed', 'leadershipRosterConfirmed',
          'supervisionConfirmed', 'attachmentCount', 'version',
          'submittedAt', 'reviewNote', 'reviewedByUid', 'reviewedByName',
          'reviewedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'chapterId', 'chapterName', 'type', 'title', 'status',
          'submittedByUid', 'submittedByName', 'submittedByRole',
          'reportingPeriod', 'meetingDate', 'eventDate', 'eventLocation',
          'requestedStartDate', 'requestedEndDate', 'currentValue',
          'proposedValue', 'requestedChange', 'summary', 'details',
          'nextSteps', 'supervisionPlan', 'transportationPlan', 'budgetNotes',
          'attendance', 'volunteerCount', 'volunteerHours',
          'institutionalApprovalConfirmed', 'leadershipRosterConfirmed',
          'supervisionConfirmed', 'attachmentCount', 'version',
          'submittedAt', 'reviewNote', 'reviewedByUid', 'reviewedByName',
          'reviewedAt', 'createdAt', 'updatedAt'
        ])
        && validChapterId(request.resource.data.chapterId)
        && request.resource.data.chapterName is string
        && request.resource.data.chapterName.size() >= 2
        && request.resource.data.chapterName.size() <= 180
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.submittedByName is string
        && request.resource.data.submittedByName.size() >= 2
        && request.resource.data.submittedByName.size() <= 100
        && request.resource.data.submittedByRole == chapterMembership(chapterId).role
        && request.resource.data.status == 'draft'
        && request.resource.data.attachmentCount == 0
        && request.resource.data.version == 1
        && request.resource.data.submittedAt == null
        && request.resource.data.reviewNote == ''
        && request.resource.data.reviewedByUid == ''
        && request.resource.data.reviewedByName == ''
        && request.resource.data.reviewedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validSubmissionContent(request.resource.data);
    }

    function validMemberSubmissionEdit() {
      let chapterId = resource.data.chapterId;
      return hasChapterMembership(chapterId)
        && resource.data.submittedByUid == request.auth.uid
        && resource.data.status in ['draft', 'changes_requested']
        && request.resource.data.chapterId == resource.data.chapterId
        && request.resource.data.chapterName == resource.data.chapterName
        && request.resource.data.type == resource.data.type
        && request.resource.data.submittedByUid == resource.data.submittedByUid
        && request.resource.data.submittedByName == resource.data.submittedByName
        && request.resource.data.submittedByRole == resource.data.submittedByRole
        && request.resource.data.version == resource.data.version
        && request.resource.data.reviewNote == resource.data.reviewNote
        && request.resource.data.reviewedByUid == resource.data.reviewedByUid
        && request.resource.data.reviewedByName == resource.data.reviewedByName
        && request.resource.data.reviewedAt == resource.data.reviewedAt
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'status', 'reportingPeriod', 'meetingDate', 'eventDate',
          'eventLocation', 'requestedStartDate', 'requestedEndDate',
          'currentValue', 'proposedValue', 'requestedChange', 'summary',
          'details', 'nextSteps', 'supervisionPlan', 'transportationPlan',
          'budgetNotes', 'attendance', 'volunteerCount', 'volunteerHours',
          'institutionalApprovalConfirmed', 'leadershipRosterConfirmed',
          'supervisionConfirmed', 'attachmentCount', 'submittedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['draft', 'submitted']
        && ((request.resource.data.status == 'draft' && request.resource.data.submittedAt == null)
          || (request.resource.data.status == 'submitted' && request.resource.data.submittedAt == request.time))
        && request.resource.data.updatedAt == request.time
        && validSubmissionContent(request.resource.data);
    }

    function validMemberWithdrawal() {
      return hasChapterMembership(resource.data.chapterId)
        && resource.data.submittedByUid == request.auth.uid
        && resource.data.status in ['submitted', 'under_review', 'changes_requested']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'withdrawn'
        && request.resource.data.updatedAt == request.time;
    }

    function validAdministrativeReview() {
      return canReviewSubmissions()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewNote', 'reviewedByUid', 'reviewedByName',
          'reviewedAt', 'updatedAt'
        ])
        && request.resource.data.status in [
          'submitted', 'under_review', 'changes_requested', 'approved', 'denied'
        ]
        && request.resource.data.reviewNote is string
        && request.resource.data.reviewNote.size() <= 3000
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.reviewedByName is string
        && request.resource.data.reviewedByName.size() >= 2
        && request.resource.data.reviewedByName.size() <= 100
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validAttachment(submissionId, attachmentId) {
      let submission = get(/databases/$(database)/documents/chapterSubmissions/$(submissionId)).data;
      return hasChapterMembership(request.resource.data.chapterId)
        && submission.submittedByUid == request.auth.uid
        && submission.chapterId == request.resource.data.chapterId
        && submission.status in ['draft', 'changes_requested']
        && request.resource.data.keys().hasAll([
          'attachmentId', 'chapterId', 'submissionId', 'fileName',
          'contentType', 'size', 'chunkCount', 'storageMode',
          'uploadedByUid', 'uploadedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'attachmentId', 'chapterId', 'submissionId', 'fileName',
          'contentType', 'size', 'chunkCount', 'storageMode',
          'uploadedByUid', 'uploadedAt'
        ])
        && request.resource.data.attachmentId == attachmentId
        && request.resource.data.submissionId == submissionId
        && request.resource.data.uploadedByUid == request.auth.uid
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() >= 1
        && request.resource.data.fileName.size() <= 240
        && request.resource.data.contentType in [
          'application/pdf', 'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'image/png', 'image/jpeg'
        ]
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 2097152
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount >= 1
        && request.resource.data.chunkCount <= 7
        && request.resource.data.storageMode == 'firestore_chunks'
        && request.resource.data.uploadedAt == request.time;
    }

    function validSubmissionAttachmentChunk(submissionId, attachmentId) {
      let submission = get(/databases/$(database)/documents/chapterSubmissions/$(submissionId)).data;
      let attachment = getAfter(/databases/$(database)/documents/chapterSubmissions/$(submissionId)/attachments/$(attachmentId)).data;
      return hasChapterMembership(submission.chapterId)
        && submission.submittedByUid == request.auth.uid
        && submission.status in ['draft', 'changes_requested']
        && attachment.uploadedByUid == request.auth.uid
        && attachment.storageMode == 'firestore_chunks'
        && request.resource.data.keys().hasAll(['attachmentId', 'index', 'data', 'createdAt'])
        && request.resource.data.keys().hasOnly(['attachmentId', 'index', 'data', 'createdAt'])
        && request.resource.data.attachmentId == attachmentId
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.index < attachment.chunkCount
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 450000
        && request.resource.data.createdAt == request.time;
    }

    function supportTicket(ticketId) {
      return get(/databases/$(database)/documents/supportTickets/$(ticketId)).data;
    }

    function supportTicketAfter(ticketId) {
      return getAfter(/databases/$(database)/documents/supportTickets/$(ticketId)).data;
    }

    function canAccessSupportTicketData(ticket) {
      return canManageSupport()
        || (hasChapterMembership(ticket.chapterId)
          && (ticket.visibility == 'chapter'
            || (ticket.visibility == 'adviser_private'
              && ticket.createdByUid == request.auth.uid
              && hasChapterMembershipRole(ticket.chapterId, ['adviser']))));
    }

    function validNewSupportTicket(ticketId) {
      let chapterId = request.resource.data.chapterId;
      let membership = chapterMembership(chapterId);
      return hasChapterMembershipRole(chapterId, ['director', 'adviser'])
        && ticketId == request.resource.data.ticketId
        && request.resource.data.keys().hasAll([
          'ticketId', 'chapterId', 'chapterName', 'category', 'priority',
          'visibility', 'subject', 'status', 'createdByUid', 'createdByName',
          'createdByRole', 'assignedToUid', 'assignedToName', 'accessKeys',
          'lastMessageAt', 'lastMessagePreview', 'lastMessageByUid',
          'lastMessageByName', 'lastMessageSenderType', 'messageCount',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ticketId', 'chapterId', 'chapterName', 'category', 'priority',
          'visibility', 'subject', 'status', 'createdByUid', 'createdByName',
          'createdByRole', 'assignedToUid', 'assignedToName', 'accessKeys',
          'lastMessageAt', 'lastMessagePreview', 'lastMessageByUid',
          'lastMessageByName', 'lastMessageSenderType', 'messageCount',
          'createdAt', 'updatedAt'
        ])
        && validChapterId(chapterId)
        && request.resource.data.chapterName is string
        && request.resource.data.chapterName.size() >= 2
        && request.resource.data.chapterName.size() <= 180
        && request.resource.data.category in [
          'general_assistance', 'technical_support', 'chapter_compliance',
          'document_review', 'leadership_change', 'renewal_assistance',
          'institutional_concern', 'urgent_safety_concern'
        ]
        && request.resource.data.priority in ['low', 'normal', 'high', 'urgent']
        && request.resource.data.visibility in ['chapter', 'adviser_private']
        && (request.resource.data.visibility != 'adviser_private' || membership.role == 'adviser')
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 5
        && request.resource.data.subject.size() <= 160
        && request.resource.data.status == 'open'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() >= 2
        && request.resource.data.createdByName.size() <= 100
        && request.resource.data.createdByRole == membership.role
        && request.resource.data.assignedToUid == ''
        && request.resource.data.assignedToName == ''
        && request.resource.data.accessKeys is list
        && ((request.resource.data.visibility == 'chapter'
              && request.resource.data.accessKeys.size() == 2
              && ('chapter:' + chapterId) in request.resource.data.accessKeys
              && ('user:' + request.auth.uid) in request.resource.data.accessKeys)
            || (request.resource.data.visibility == 'adviser_private'
              && request.resource.data.accessKeys.size() == 1
              && ('user:' + request.auth.uid) in request.resource.data.accessKeys))
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.lastMessagePreview.size() >= 1
        && request.resource.data.lastMessagePreview.size() <= 180
        && request.resource.data.lastMessageByUid == request.auth.uid
        && request.resource.data.lastMessageByName == request.resource.data.createdByName
        && request.resource.data.lastMessageSenderType == 'chapter'
        && request.resource.data.messageCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validChapterSupportUpdate() {
      return canAccessSupportTicketData(resource.data)
        && !canManageSupport()
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && resource.data.status != 'closed'
            && request.resource.data.status == 'closed'
            && request.resource.data.updatedAt == request.time)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'lastMessageAt', 'lastMessagePreview', 'lastMessageByUid',
              'lastMessageByName', 'lastMessageSenderType', 'messageCount', 'updatedAt'
            ])
            && resource.data.status != 'closed'
            && request.resource.data.status == 'awaiting_staff'
            && request.resource.data.lastMessageAt == request.time
            && request.resource.data.lastMessagePreview is string
            && request.resource.data.lastMessagePreview.size() >= 1
            && request.resource.data.lastMessagePreview.size() <= 180
            && request.resource.data.lastMessageByUid == request.auth.uid
            && request.resource.data.lastMessageByName is string
            && request.resource.data.lastMessageByName.size() >= 2
            && request.resource.data.lastMessageByName.size() <= 100
            && request.resource.data.lastMessageSenderType == 'chapter'
            && request.resource.data.messageCount == resource.data.messageCount + 1
            && request.resource.data.updatedAt == request.time));
    }

    function validSupportMessage(ticketId) {
      let ticket = supportTicketAfter(ticketId);
      let staff = canManageSupport();
      return canAccessSupportTicketData(ticket)
        && ticket.status != 'closed'
        && request.resource.data.keys().hasAll([
          'ticketId', 'chapterId', 'authorUid', 'authorName', 'authorRole',
          'senderType', 'body', 'hasAttachments', 'attachmentCount', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ticketId', 'chapterId', 'authorUid', 'authorName', 'authorRole',
          'senderType', 'body', 'hasAttachments', 'attachmentCount', 'createdAt'
        ])
        && request.resource.data.ticketId == ticketId
        && request.resource.data.chapterId == ticket.chapterId
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 2
        && request.resource.data.authorName.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 5000
        && request.resource.data.hasAttachments == false
        && request.resource.data.attachmentCount == 0
        && request.resource.data.createdAt == request.time
        && ((staff
              && request.resource.data.senderType == 'staff'
              && request.resource.data.authorRole in ['owner', 'chapterAdmin', 'complianceAdmin', 'supportAgent'])
            || (!staff
              && request.resource.data.senderType == 'chapter'
              && request.resource.data.authorRole == chapterMembership(ticket.chapterId).role));
    }

    function validSupportMessageAttachmentUpdate(ticketId) {
      let ticket = supportTicket(ticketId);
      return canAccessSupportTicketData(ticket)
        && (resource.data.authorUid == request.auth.uid || canManageSupport())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hasAttachments', 'attachmentCount'
        ])
        && request.resource.data.hasAttachments == true
        && request.resource.data.attachmentCount is int
        && request.resource.data.attachmentCount >= 1
        && request.resource.data.attachmentCount <= 5;
    }

    function validSupportAttachment(ticketId, messageId, attachmentId) {
      let ticket = supportTicket(ticketId);
      let message = get(/databases/$(database)/documents/supportTickets/$(ticketId)/messages/$(messageId)).data;
      return canAccessSupportTicketData(ticket)
        && (message.authorUid == request.auth.uid || canManageSupport())
        && request.resource.data.keys().hasAll([
          'attachmentId', 'ticketId', 'chapterId', 'messageId',
          'uploadedByUid', 'fileName', 'contentType', 'size',
          'chunkCount', 'storageMode', 'uploadedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'attachmentId', 'ticketId', 'chapterId', 'messageId',
          'uploadedByUid', 'fileName', 'contentType', 'size',
          'chunkCount', 'storageMode', 'uploadedAt'
        ])
        && request.resource.data.attachmentId == attachmentId
        && request.resource.data.ticketId == ticketId
        && request.resource.data.chapterId == ticket.chapterId
        && request.resource.data.messageId == messageId
        && request.resource.data.uploadedByUid == request.auth.uid
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() >= 1
        && request.resource.data.fileName.size() <= 240
        && request.resource.data.contentType in [
          'application/pdf', 'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'image/png', 'image/jpeg'
        ]
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 2097152
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount >= 1
        && request.resource.data.chunkCount <= 7
        && request.resource.data.storageMode == 'firestore_chunks'
        && request.resource.data.uploadedAt == request.time;
    }

    function validSupportAttachmentChunk(ticketId, messageId, attachmentId) {
      let ticket = supportTicket(ticketId);
      let attachment = getAfter(/databases/$(database)/documents/supportTickets/$(ticketId)/messages/$(messageId)/attachments/$(attachmentId)).data;
      return canAccessSupportTicketData(ticket)
        && attachment.uploadedByUid == request.auth.uid
        && attachment.storageMode == 'firestore_chunks'
        && request.resource.data.keys().hasAll(['attachmentId', 'index', 'data', 'createdAt'])
        && request.resource.data.keys().hasOnly(['attachmentId', 'index', 'data', 'createdAt'])
        && request.resource.data.attachmentId == attachmentId
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.index < attachment.chunkCount
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 450000
        && request.resource.data.createdAt == request.time;
    }

    function validSupportReadState(readStateId) {
      let ticket = supportTicketAfter(request.resource.data.ticketId);
      return signedIn()
        && readStateId == request.resource.data.ticketId + '__' + request.auth.uid
        && canAccessSupportTicketData(ticket)
        && request.resource.data.keys().hasAll([
          'ticketId', 'chapterId', 'uid', 'lastReadAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ticketId', 'chapterId', 'uid', 'lastReadAt', 'updatedAt'
        ])
        && request.resource.data.chapterId == ticket.chapterId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lastReadAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validInternalSupportNote(ticketId) {
      let ticket = supportTicket(ticketId);
      return canManageSupport()
        && request.resource.data.keys().hasAll([
          'ticketId', 'chapterId', 'authorUid', 'authorName', 'authorRole',
          'body', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ticketId', 'chapterId', 'authorUid', 'authorName', 'authorRole',
          'body', 'createdAt'
        ])
        && request.resource.data.ticketId == ticketId
        && request.resource.data.chapterId == ticket.chapterId
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 2
        && request.resource.data.authorName.size() <= 100
        && request.resource.data.authorRole in ['owner', 'chapterAdmin', 'complianceAdmin', 'supportAgent']
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 3
        && request.resource.data.body.size() <= 3000
        && request.resource.data.createdAt == request.time;
    }


    function canManageFormTemplates() {
      return isOwner();
    }

    function canReviewRequiredForms() {
      return hasRole(['owner', 'chapterAdmin', 'complianceAdmin']);
    }

    function formAssignment(assignmentId) {
      return get(/databases/$(database)/documents/formAssignments/$(assignmentId)).data;
    }

    function canAccessFormAssignmentData(data) {
      return canReviewRequiredForms()
        || (data.chapterId is string
          && hasChapterMembershipRole(data.chapterId, ['director', 'adviser']));
    }

    function canAccessFormAssignment(assignmentId) {
      return exists(/databases/$(database)/documents/formAssignments/$(assignmentId))
        && canAccessFormAssignmentData(formAssignment(assignmentId));
    }

    function formResponseStatusEditable(status) {
      return status in ['draft', 'awaiting_adviser', 'submitted', 'changes_requested'];
    }

    function formResponseBaseValid(assignmentId, data) {
      let assignment = formAssignment(assignmentId);
      return data.keys().hasAll([
          'assignmentId', 'campaignId', 'templateId', 'versionId', 'chapterId',
          'workflow', 'status', 'currentStep', 'returnRole',
          'directorAnswersJson', 'adviserAnswersJson',
          'directorCertificationName', 'directorCertificationTitle',
          'directorCertifiedAt', 'directorUid',
          'adviserCertificationName', 'adviserCertificationTitle',
          'adviserCertifiedAt', 'adviserUid', 'submittedAt',
          'reviewNote', 'reviewedByUid', 'reviewedByName', 'reviewedAt',
          'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'assignmentId', 'campaignId', 'templateId', 'versionId', 'chapterId',
          'workflow', 'status', 'currentStep', 'returnRole',
          'directorAnswersJson', 'adviserAnswersJson',
          'directorCertificationName', 'directorCertificationTitle',
          'directorCertifiedAt', 'directorUid',
          'adviserCertificationName', 'adviserCertificationTitle',
          'adviserCertifiedAt', 'adviserUid', 'submittedAt',
          'reviewNote', 'reviewedByUid', 'reviewedByName', 'reviewedAt',
          'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt'
        ])
        && data.assignmentId == assignmentId
        && data.campaignId == assignment.campaignId
        && data.templateId == assignment.templateId
        && data.versionId == assignment.versionId
        && data.chapterId == assignment.chapterId
        && data.workflow == assignment.workflow
        && data.status in [
          'draft', 'awaiting_adviser', 'submitted', 'changes_requested',
          'approved', 'denied', 'waived'
        ]
        && data.currentStep in ['director', 'adviser', 'review', 'complete']
        && data.returnRole in ['', 'director', 'adviser']
        && data.directorAnswersJson is string
        && data.directorAnswersJson.size() <= 200000
        && data.adviserAnswersJson is string
        && data.adviserAnswersJson.size() <= 200000
        && data.directorCertificationName is string
        && data.directorCertificationName.size() <= 100
        && data.directorCertificationTitle is string
        && data.directorCertificationTitle.size() <= 100
        && (data.directorCertifiedAt == null || data.directorCertifiedAt is timestamp)
        && data.directorUid is string
        && data.directorUid.size() <= 128
        && data.adviserCertificationName is string
        && data.adviserCertificationName.size() <= 100
        && data.adviserCertificationTitle is string
        && data.adviserCertificationTitle.size() <= 100
        && (data.adviserCertifiedAt == null || data.adviserCertifiedAt is timestamp)
        && data.adviserUid is string
        && data.adviserUid.size() <= 128
        && (data.submittedAt == null || data.submittedAt is timestamp)
        && data.reviewNote is string
        && data.reviewNote.size() <= 3000
        && data.reviewedByUid is string
        && data.reviewedByUid.size() <= 128
        && data.reviewedByName is string
        && data.reviewedByName.size() <= 100
        && (data.reviewedAt == null || data.reviewedAt is timestamp)
        && data.createdByUid is string
        && data.createdByUid.size() > 0
        && data.createdAt is timestamp
        && data.updatedByUid is string
        && data.updatedByUid.size() > 0
        && data.updatedAt is timestamp;
    }

    function validNewFormResponse(assignmentId) {
      let assignment = formAssignment(assignmentId);
      let role = chapterMembership(assignment.chapterId).role;
      return hasChapterMembershipRole(assignment.chapterId, ['director', 'adviser'])
        && assignment.status == 'assigned'
        && formResponseBaseValid(assignmentId, request.resource.data)
        && formResponseStatusEditable(request.resource.data.status)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedByUid == ''
        && request.resource.data.reviewedByName == ''
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewNote == ''
        && ((role == 'director'
              && assignment.workflow in ['single_director', 'director_then_adviser']
              && request.resource.data.adviserAnswersJson == '{}'
              && request.resource.data.adviserCertificationName == ''
              && request.resource.data.adviserCertificationTitle == ''
              && request.resource.data.adviserCertifiedAt == null
              && request.resource.data.adviserUid == '')
            || (role == 'adviser'
              && assignment.workflow == 'single_adviser'
              && request.resource.data.directorAnswersJson == '{}'
              && request.resource.data.directorCertificationName == ''
              && request.resource.data.directorCertificationTitle == ''
              && request.resource.data.directorCertifiedAt == null
              && request.resource.data.directorUid == ''));
    }

    function validFormResponseUpdate(assignmentId) {
      let assignment = formAssignment(assignmentId);
      let role = chapterMembership(assignment.chapterId).role;
      let commonKeys = [
        'status', 'currentStep', 'returnRole', 'submittedAt', 'reviewNote',
        'updatedByUid', 'updatedAt'
      ];
      return hasChapterMembershipRole(assignment.chapterId, ['director', 'adviser'])
        && !(resource.data.status in ['approved', 'denied', 'waived'])
        && role == resource.data.currentStep
        && formResponseBaseValid(assignmentId, request.resource.data)
        && formResponseStatusEditable(request.resource.data.status)
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.reviewedByUid == resource.data.reviewedByUid
        && request.resource.data.reviewedByName == resource.data.reviewedByName
        && request.resource.data.reviewedAt == resource.data.reviewedAt
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && ((role == 'director'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                (commonKeys + [
                  'directorAnswersJson', 'directorCertificationName',
                  'directorCertificationTitle', 'directorCertifiedAt', 'directorUid'
                ]))
              && assignment.workflow in ['single_director', 'director_then_adviser'])
            || (role == 'adviser'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                (commonKeys + [
                  'adviserAnswersJson', 'adviserCertificationName',
                  'adviserCertificationTitle', 'adviserCertifiedAt', 'adviserUid'
                ]))
              && assignment.workflow in ['single_adviser', 'director_then_adviser']));
    }

    function validFormHistoryEvent(assignmentId) {
      let assignment = formAssignment(assignmentId);
      return canAccessFormAssignment(assignmentId)
        && request.resource.data.keys().hasAll([
          'assignmentId', 'chapterId', 'eventType', 'actorUid',
          'actorName', 'actorRole', 'note', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'assignmentId', 'chapterId', 'eventType', 'actorUid',
          'actorName', 'actorRole', 'note', 'createdAt'
        ])
        && request.resource.data.assignmentId == assignmentId
        && request.resource.data.chapterId == assignment.chapterId
        && request.resource.data.eventType in [
          'director_submitted', 'response_submitted', 'approved',
          'changes_requested', 'denied', 'waived'
        ]
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() >= 2
        && request.resource.data.actorName.size() <= 100
        && request.resource.data.actorRole is string
        && request.resource.data.actorRole.size() <= 40
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 3000
        && request.resource.data.createdAt == request.time;
    }

    function validFormAttachment(assignmentId) {
      let assignment = formAssignment(assignmentId);
      return canAccessFormAssignment(assignmentId)
        && request.resource.data.keys().hasAll([
          'assignmentId', 'chapterId', 'responseId', 'fieldId',
          'uploadedByUid', 'uploadedByRole', 'attachmentId', 'fileName',
          'contentType', 'size', 'chunkCount', 'storageMode', 'uploadedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'assignmentId', 'chapterId', 'responseId', 'fieldId',
          'uploadedByUid', 'uploadedByRole', 'attachmentId', 'fileName',
          'contentType', 'size', 'chunkCount', 'storageMode', 'uploadedAt'
        ])
        && request.resource.data.assignmentId == assignmentId
        && request.resource.data.chapterId == assignment.chapterId
        && request.resource.data.responseId == 'current'
        && request.resource.data.uploadedByUid == request.auth.uid
        && request.resource.data.uploadedByRole is string
        && request.resource.data.uploadedByRole.size() <= 40
        && request.resource.data.attachmentId is string
        && request.resource.data.attachmentId.size() > 0
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() >= 1
        && request.resource.data.fileName.size() <= 240
        && request.resource.data.contentType in [
          'application/pdf', 'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'image/png', 'image/jpeg'
        ]
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 2097152
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount >= 1
        && request.resource.data.chunkCount <= 8
        && request.resource.data.storageMode == 'firestore_chunks'
        && request.resource.data.uploadedAt == request.time;
    }

    function formAttachmentAfter(assignmentId, attachmentId) {
      return getAfter(/databases/$(database)/documents/formAssignments/$(assignmentId)/responses/current/attachments/$(attachmentId)).data;
    }

    function validFormAttachmentChunk(assignmentId, attachmentId) {
      let attachment = formAttachmentAfter(assignmentId, attachmentId);
      return canAccessFormAssignment(assignmentId)
        && attachment.uploadedByUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'attachmentId', 'index', 'data', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'attachmentId', 'index', 'data', 'createdAt'
        ])
        && request.resource.data.attachmentId == attachmentId
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.index < 8
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 500000
        && request.resource.data.createdAt == request.time;
    }

    match /systemUsers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow read: if isAdministrativeStaff();
      allow create: if isOwner() || validSelfActivatedProfile(uid);
      allow delete: if isOwner();
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.accountStatus == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'updatedAt']);
      allow update: if isOwner();
    }

    match /systemSettings/{documentId} {
      allow get: if documentId == 'portal' || isActive();
      allow list: if isActive();
      allow create, update, delete: if isOwner();
    }

    match /publicChapterRegistry/{chapterId} {
      allow get, list: if canManageChapterWorkspaces() || resource.data.isPublished == true;
      allow create, update, delete: if canManageRegistry();
    }

    match /chapterInvitations/{inviteId} {
      allow get: if resource.data.status == 'pending'
        && resource.data.expiresAt > request.time;
      allow list: if canManageInvitations();
      allow create: if canManageInvitations()
        && request.resource.data.keys().hasAll([
          'activationCodeHash', 'codeHint', 'email', 'displayName',
          'chapterId', 'chapterName', 'role', 'status', 'expiresAt',
          'note', 'version', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'activationCodeHash', 'codeHint', 'email', 'displayName',
          'chapterId', 'chapterName', 'role', 'status', 'expiresAt',
          'note', 'version', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.activationCodeHash == inviteId
        && request.resource.data.codeHint is string
        && request.resource.data.codeHint.size() == 5
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 160
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && validChapterId(request.resource.data.chapterId)
        && request.resource.data.chapterName is string
        && request.resource.data.chapterName.size() >= 2
        && request.resource.data.chapterName.size() <= 180
        && request.resource.data.role in ['director', 'adviser']
        && request.resource.data.status == 'pending'
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.version == 1
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && invitationChapterIsReady(
          request.resource.data.chapterId,
          request.resource.data.chapterName
        );
      allow update: if canManageInvitations() || validInvitationClaim(inviteId);
      allow delete: if isOwner();
    }

    match /chapterMemberships/{memberId} {
      allow read: if isAdministrativeStaff();
      allow read: if signedIn()
        && resource.data.uid == request.auth.uid
        && true;
      allow create: if canManageInvitations() || validSelfMembership(memberId);
      allow update, delete: if canManageInvitations();
    }

    match /chapters/{chapterId} {
      allow read: if canReadChapterOperations() || hasChapterMembership(chapterId);
      allow create, update, delete: if canManageChapterWorkspaces();

      match /requirements/{requirementId} {
        allow read: if canReadChapterOperations() || hasChapterMembership(chapterId);
        allow create, update, delete: if canManageChapterWorkspaces();
      }

      match /leaders/{leaderId} {
        allow read: if canReadChapterOperations() || hasChapterMembership(chapterId);
        allow create: if canManageChapterWorkspaces() || validSelfLeader(chapterId, leaderId);
        allow update, delete: if canManageChapterWorkspaces();
      }

      match /members/{memberId} {
        allow read: if canReadChapterOperations() || hasChapterMembership(chapterId);
        allow create: if validNewChapterRosterMember(chapterId);
        allow update: if validChapterRosterMemberUpdate(chapterId);
        allow delete: if isOwner();
      }

      match /documents/{documentId} {
        allow read: if canReadChapterOperations() || hasChapterMembership(chapterId);
        allow create, update, delete: if canManageChapterWorkspaces();
      }

      match /notices/{noticeId} {
        allow read: if canReadChapterOperations() || hasChapterMembership(chapterId);
        allow create, update, delete: if canManageChapterWorkspaces();
      }

      match /noticeReceipts/{receiptId} {
        allow get: if canReadChapterOperations() || hasChapterMembership(chapterId);
        allow list: if canReadChapterOperations();
        allow create, update: if validNoticeReceipt(chapterId, receiptId);
        allow delete: if canManageChapterWorkspaces();
      }

      match /adviserCheckins/{checkinId} {
        allow read: if canManageChapterWorkspaces()
          || (hasChapterMembershipRole(chapterId, ['adviser'])
            && resource.data.createdByUid == request.auth.uid);
        allow create: if validAdviserCheckin(chapterId);
        allow update: if canManageChapterWorkspaces();
        allow delete: if isOwner();
      }
    }

    match /chapterSubmissions/{submissionId} {
      allow read: if canReadChapterOperations() || hasChapterMembership(resource.data.chapterId);
      allow create: if validNewSubmission();
      allow update: if validMemberSubmissionEdit()
        || validMemberWithdrawal()
        || validAdministrativeReview();
      allow delete: if isOwner();

      match /attachments/{attachmentId} {
        allow read: if canReadChapterOperations()
          || hasChapterMembership(get(/databases/$(database)/documents/chapterSubmissions/$(submissionId)).data.chapterId);
        allow create: if validAttachment(submissionId, attachmentId);
        allow update: if false;
        allow delete: if canReviewSubmissions()
          || (signedIn()
            && get(/databases/$(database)/documents/chapterSubmissions/$(submissionId)).data.submittedByUid == request.auth.uid
            && get(/databases/$(database)/documents/chapterSubmissions/$(submissionId)).data.status in ['draft', 'changes_requested']);

        match /chunks/{chunkId} {
          allow read: if canReadChapterOperations()
            || hasChapterMembership(get(/databases/$(database)/documents/chapterSubmissions/$(submissionId)).data.chapterId);
          allow create: if validSubmissionAttachmentChunk(submissionId, attachmentId);
          allow update: if false;
          allow delete: if canReviewSubmissions()
            || (signedIn()
              && get(/databases/$(database)/documents/chapterSubmissions/$(submissionId)).data.submittedByUid == request.auth.uid
              && get(/databases/$(database)/documents/chapterSubmissions/$(submissionId)).data.status in ['draft', 'changes_requested']);
        }
      }
    }


    match /formTemplates/{templateId} {
      allow read: if isActive();
      allow create, update, delete: if canManageFormTemplates();

      match /versions/{versionId} {
        allow read: if isActive();
        allow create: if canManageFormTemplates()
          && request.resource.data.templateId == templateId
          && request.resource.data.versionId == versionId
          && request.resource.data.locked == true
          && request.resource.data.schemaJson is string
          && request.resource.data.schemaJson.size() > 2
          && request.resource.data.schemaJson.size() <= 700000
          && request.resource.data.publishedByUid == request.auth.uid
          && request.resource.data.publishedAt == request.time;
        allow update, delete: if false;
      }
    }

    match /formCampaigns/{campaignId} {
      allow read: if canReviewRequiredForms();
      allow create, update, delete: if isOwner();
    }

    match /formAssignments/{assignmentId} {
      allow read: if canAccessFormAssignmentData(resource.data);
      allow create: if isOwner()
        && request.resource.data.assignmentId == assignmentId
        && validChapterId(request.resource.data.chapterId)
        && request.resource.data.status == 'assigned'
        && request.resource.data.workflow in [
          'single_director', 'single_adviser', 'director_then_adviser'
        ]
        && request.resource.data.schemaJson is string
        && request.resource.data.schemaJson.size() > 2
        && request.resource.data.schemaJson.size() <= 700000
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canReviewRequiredForms();
      allow delete: if isOwner();

      match /responses/{responseId} {
        allow read: if canAccessFormAssignment(assignmentId);
        allow create: if responseId == 'current'
          && (validNewFormResponse(assignmentId) || canReviewRequiredForms());
        allow update: if responseId == 'current'
          && (validFormResponseUpdate(assignmentId) || canReviewRequiredForms());
        allow delete: if isOwner();

        match /history/{historyId} {
          allow read: if canAccessFormAssignment(assignmentId);
          allow create: if validFormHistoryEvent(assignmentId);
          allow update, delete: if false;
        }

        match /attachments/{attachmentId} {
          allow read: if canAccessFormAssignment(assignmentId);
          allow create: if validFormAttachment(assignmentId);
          allow update: if false;
          allow delete: if canReviewRequiredForms()
            || (hasChapterMembershipRole(formAssignment(assignmentId).chapterId, ['director', 'adviser'])
              && resource.data.uploadedByUid == request.auth.uid);

          match /chunks/{chunkId} {
            allow read: if canAccessFormAssignment(assignmentId);
            allow create: if validFormAttachmentChunk(assignmentId, attachmentId);
            allow update: if false;
            allow delete: if canReviewRequiredForms()
              || hasChapterMembershipRole(formAssignment(assignmentId).chapterId, ['director', 'adviser']);
          }
        }
      }
    }

    match /supportTickets/{ticketId} {
      allow read: if canManageSupport();
      allow read: if canAccessSupportTicketData(resource.data);
      allow create: if validNewSupportTicket(ticketId);
      allow update: if canManageSupport() || validChapterSupportUpdate();
      allow delete: if isOwner();

      match /messages/{messageId} {
        allow read: if canAccessSupportTicketData(supportTicket(ticketId));
        allow create: if validSupportMessage(ticketId);
        allow update: if validSupportMessageAttachmentUpdate(ticketId);
        allow delete: if isOwner();

        match /attachments/{attachmentId} {
          allow read: if canAccessSupportTicketData(supportTicket(ticketId));
          allow create: if validSupportAttachment(ticketId, messageId, attachmentId);
          allow update: if false;
          allow delete: if isOwner() || canManageSupport();

          match /chunks/{chunkId} {
            allow read: if canAccessSupportTicketData(supportTicket(ticketId));
            allow create: if validSupportAttachmentChunk(ticketId, messageId, attachmentId);
            allow update: if false;
            allow delete: if isOwner() || canManageSupport();
          }
        }
      }

      match /internalNotes/{noteId} {
        allow read: if canManageSupport();
        allow create: if validInternalSupportNote(ticketId);
        allow update: if false;
        allow delete: if isOwner();
      }
    }

    match /supportReadStates/{readStateId} {
      allow read: if canManageSupport()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if validSupportReadState(readStateId);
      allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /unauthorizedChapterReports/{reportId} {
      allow create: if request.resource.data.keys().hasAll([
          'reportType', 'reporterName', 'reporterEmail', 'relationship',
          'chapterName', 'institution', 'location', 'details', 'consent',
          'status', 'source', 'pageUrl', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'reportType', 'reporterName', 'reporterEmail', 'relationship',
          'chapterName', 'chapterId', 'institution', 'location', 'details',
          'consent', 'status', 'source', 'pageUrl', 'createdAt'
        ])
        && request.resource.data.reportType == 'unauthorized_chapter'
        && request.resource.data.reporterName is string
        && request.resource.data.reporterName.size() >= 2
        && request.resource.data.reporterName.size() <= 100
        && request.resource.data.reporterEmail is string
        && request.resource.data.reporterEmail.size() >= 5
        && request.resource.data.reporterEmail.size() <= 160
        && request.resource.data.relationship is string
        && request.resource.data.relationship.size() >= 2
        && request.resource.data.relationship.size() <= 80
        && request.resource.data.chapterName is string
        && request.resource.data.chapterName.size() >= 2
        && request.resource.data.chapterName.size() <= 160
        && (!('chapterId' in request.resource.data)
          || (request.resource.data.chapterId is string
            && request.resource.data.chapterId.size() <= 40))
        && request.resource.data.institution is string
        && request.resource.data.institution.size() >= 2
        && request.resource.data.institution.size() <= 180
        && request.resource.data.location is string
        && request.resource.data.location.size() >= 2
        && request.resource.data.location.size() <= 120
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 20
        && request.resource.data.details.size() <= 2000
        && request.resource.data.consent == true
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'public_registry'
        && request.resource.data.pageUrl is string
        && request.resource.data.pageUrl.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow read: if isAdministrativeStaff();
      allow update: if hasRole(['owner', 'chapterAdmin', 'supportAgent']);
      allow delete: if isOwner();
    }

    match /auditLogs/{auditId} {
      allow read: if isAdministrativeStaff();
      allow create: if isActive()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.keys().hasAll(['actorUid', 'action', 'createdAt'])
        && request.resource.data.keys().hasOnly([
          'actorUid', 'action', 'targetType', 'targetId', 'summary', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
